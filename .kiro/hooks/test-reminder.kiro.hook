{
  "enabled": true,
  "name": "Test Game Reminder",
  "description": "Reminds to test the game after implementing new features or fixing bugs",
  "version": "1",
  "when": {
    "type": "postTaskExecution"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Remind the user to test the game in Godot to verify the changes work correctly"
  }
}