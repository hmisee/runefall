{
  "enabled": true,
  "name": "Auto-commit GDScript Changes",
  "description": "Automatically commits changes to GDScript files when saved",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*.gd"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "$env:Path = [System.Environment]::GetEnvironmentVariable('Path','Machine') + ';' + [System.Environment]::GetEnvironmentVariable('Path','User'); git add scripts/*.gd; git commit -m 'Update: GDScript changes'"
  }
}